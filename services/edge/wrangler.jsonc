{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexustimer-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "routes": [{ "pattern": "nexustimer.com/api/*", "zone_name": "nexustimer.com" }],
  "vars": {
    "API_ORIGIN": "https://api.nexustimer.com"
  },
  "observability": {
    "enabled": true
  }
}
