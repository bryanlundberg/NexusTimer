{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexustimer-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "routes": [{ "pattern": "beta.nexustimer.com", "custom_domain": true }],
  "vars": {
    "API_ORIGIN": "https://api.nexustimer.com"
  },
  "assets": {
    "directory": "../../out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/",
      "/en",
      "/en/*",
      "/people/*",
      "/s/*",
      "/free-play/*",
      "/*/people/*",
      "/*/s/*",
      "/*/free-play/*",
      "!/_next/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
