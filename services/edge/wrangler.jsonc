{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexustimer-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "routes": [{ "pattern": "nexustimer.com/*", "zone_name": "nexustimer.com" }],
  "vars": {
    "API_ORIGIN": "https://api.nexustimer.com"
  },
  "assets": {
    "directory": "../../out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/people/*",
      "/s/*",
      "/free-play/*",
      "/*/people/*",
      "/*/s/*",
      "/*/free-play/*",
      "/sign-in",
      "/sign-up",
      "/forgot-password",
      "/reset-password",
      "/friends",
      "/messages",
      "/*/sign-in",
      "/*/sign-up",
      "/*/forgot-password",
      "/*/reset-password",
      "/*/friends",
      "/*/messages",
      "!/_next/*"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
