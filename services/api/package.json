{
  "name": "@nexustimer/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@hono/node-server": "^2.1.5",
    "@nexustimer/algorithms": "workspace:*",
    "@nexustimer/avatars": "workspace:*",
    "@nexustimer/contracts": "workspace:*",
    "@nexustimer/stats": "workspace:*",
    "@nexustimer/tnoodle-lib-rs": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.12",
    "country-flag-icons": "^1.6.20",
    "hono": "^4.13.13",
    "meilisearch": "^0.62.0",
    "mongodb": "~7.7.0",
    "mongoose": "^9.11.4",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
